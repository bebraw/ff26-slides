{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ff26-slides",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-28",
  "build": {
    "command": "npm run build",
    "watch_dir": "src",
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.css", ".generated/*.json", "src/*.json", ".generated/client/*.txt", "**/*.svg"],
      "fallthrough": true,
    },
    {
      "type": "Data",
      "globs": ["**/*.ttf"],
      "fallthrough": true,
    },
  ],
}
